# SyncStream Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3001

# Spotify Integration (get these from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Apple Music Integration (get from https://developer.apple.com/musickit/)
APPLE_MUSIC_DEVELOPER_TOKEN=your_apple_developer_token_here
APPLE_MUSIC_TEAM_ID=your_team_id
APPLE_MUSIC_KEY_ID=your_key_id
